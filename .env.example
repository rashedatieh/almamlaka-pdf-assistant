# .env.example: every variable from PROJECT_PLAN §7.3, with its default.
# Copy to .env for local development. NEVER commit .env or put real secret values in this file.
# Values marked "ADR" come from docs/adr/0001-stack-and-models.md (verified 2026-10-15).

# ---- Secrets -------------------------------------------------------------------------------------
# Anthropic API key scoped to the "almamlaka-assistant" workspace. In Cloud Run: secret anthropic-api-key.
# Leave empty locally: tests and development run in replay mode and never need it.
ANTHROPIC_API_KEY=
# JSON bundle in one secret (app-secrets): {"invite_token": "...", "session_secret": "...", "canary_token": "..."}
# ACCEPTANCE_TESTS K-03 refers to SESSION_SECRET / CANARY_TOKEN: these are fields of this bundle.
APP_SECRETS=

# ---- Models (Anthropic) --------------------------------------------------------------------------
# Owner decision D19 (ADR-0001): Sonnet 5.5 on every chat route; Opus 5.5 only for the Executive report.
ANSWER_MODEL=claude-sonnet-5-5
PLANNER_MODEL=claude-sonnet-5-5
VERIFIER_MODEL=claude-sonnet-5-5
REPORT_MODEL=claude-opus-5-5
# Owner decision D1: "global" (standard price; "us" costs 1.1x).
INFERENCE_GEO=global

# ---- LLM mode ------------------------------------------------------------------------------------
# replay (dev/test default) | record | live (staging/prod). Prod refuses replay and record.
LLM_MODE=replay

# ---- Google Cloud (explicit project on every client) ---------------------------------------------
# The dedicated project ID created in docs/SETUP_ACCOUNTS.md step A. Never another project.
GCP_PROJECT=
# Cloud Run region.
GCP_REGION=me-central1
# Agent Platform (formerly Vertex AI) location for embeddings and Gemini (ADR: global; eu if EU
# processing is required; gemini-embedding-2 and Gemini models are not offered in me-central1).
VERTEX_LOCATION=global

# ---- Retrieval -----------------------------------------------------------------------------------
# gemini-embedding-001 or gemini-embedding-2: chosen by the M2 A/B and recorded in the ADR.
EMBEDDING_MODEL=
EMBEDDING_DIM=768
# false = BM25-only retrieval.
DENSE_ENABLED=true

# ---- Spend guards --------------------------------------------------------------------------------
DAILY_BUDGET_USD=1.00
MAX_TURNS_PER_SESSION=30

# ---- Feature flags (extras stay false until their milestone passes) ------------------------------
# The Voice pack (speech-to-text, text-to-speech) was removed by the owner (ADR D20); its TTS_* and
# STT_* variables from PROJECT_PLAN §7.3 are gone with it.
FEATURE_VOICE=false
FEATURE_RADAR=true
FEATURE_GRAPH=false
FEATURE_TV=false
FEATURE_CHALLENGE=false

# ---- Challenge page (M9) -------------------------------------------------------------------------
CHALLENGE_MAX_ATTEMPTS=15
CHALLENGE_LOG_CONTENT=true

# ---- App -----------------------------------------------------------------------------------------
# dev | staging | prod
APP_ENV=dev
# Not in PROJECT_PLAN §7.3: referenced by ACCEPTANCE_TESTS K-10 (prod may start without an invite
# token only when true). Default false.
PUBLIC_MODE=false
RETRIEVAL_TOP_K=8
MAX_HISTORY_TURNS=6
MAX_INPUT_CHARS=1000
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2
DENSE_TIMEOUT_S=1.5
# Requests per minute per IP.
RATE_LIMIT_PER_MIN=10
LOG_LEVEL=INFO
# Content logging is forbidden in prod except on the challenge page.
LOG_CONTENT=false
UI_DEFAULT_LANG=ar
# prod | fixtures (fixtures is refused in prod)
CORPUS_SET=prod
